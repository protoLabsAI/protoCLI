---
import BaseLayout from "../layouts/BaseLayout.astro";
import Terminal from "../components/Terminal.astro";

const features = [
  {
    title: "Local & privacy-first",
    body: "Runs on your machine against the models you host. Point it at a local or self-hosted endpoint and your code, keys, and context never leave your control.",
  },
  {
    title: "A real agent harness",
    body: "Sub-agents, teams, skills, hooks, and goal mode, with verification gates and recovery built in, not bolted on.",
  },
  {
    title: "Lives in your terminal",
    body: "Reads, writes, and runs code directly in your project. Headless mode and CI-ready for scripted, non-interactive runs.",
  },
  {
    title: "Speaks every protocol",
    body: "Drive proto as an ACP coding agent from your editor, or use it as an A2A client to chat with remote agents by name.",
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">proto · cli.protolabs.studio</p>
        <h1>A local, privacy-first AI agent <span class="gradient-text">for the terminal</span></h1>
        <p class="lead">
          proto reads, writes, and runs code right in your terminal. It works
          with the models you choose, including local and self-hosted ones. Your
          code and context never leave your control.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/docs/tutorials/getting-started">Get started</a>
          <a class="btn btn-ghost" href="/docs/">Read the docs</a>
        </div>
      </div>
      <div class="hero-term">
        <Terminal />
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="feature-grid">
        {
          features.map((f) => (
            <article class="feature">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="install">
    <div class="container install-inner">
      <h2>Up and running in one line</h2>
      <pre class="install-cmd"><span class="prompt">$</span> npm install -g proto &amp;&amp; proto</pre>
      <p class="install-note">
        Then run <a href="/docs/guides/setup-wizard"><code>proto setup</code></a> to
        configure a provider, or read the
        <a href="/docs/tutorials/getting-started">getting-started tutorial</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--pl-space-12) 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--pl-space-8);
    align-items: center;
  }
  .eyebrow {
    font-family: var(--pl-font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--pl-color-fg-muted);
    margin: 0 0 var(--pl-space-4);
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0 0 var(--pl-space-5);
  }
  .lead {
    font-size: 1.1rem;
    color: var(--pl-color-fg-muted);
    max-width: 34ch;
    margin: 0 0 var(--pl-space-6);
  }
  .cta {
    display: flex;
    gap: var(--pl-space-3);
    flex-wrap: wrap;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--pl-space-5);
  }
  .feature {
    padding: var(--pl-space-6);
    border: 1px solid var(--pl-color-border);
    border-radius: calc(var(--pl-radius) * 2);
    background: var(--pl-color-bg-raised);
  }
  .feature h3 {
    margin: 0 0 var(--pl-space-3);
    font-size: 1.05rem;
  }
  .feature p {
    margin: 0;
    color: var(--pl-color-fg-muted);
    font-size: 0.95rem;
  }
  .install {
    padding: var(--pl-space-12) 0 0;
  }
  .install-inner {
    text-align: center;
  }
  .install-cmd {
    display: inline-block;
    margin: var(--pl-space-2) auto var(--pl-space-4);
    padding: var(--pl-space-4) var(--pl-space-6);
    border: 1px solid var(--pl-color-border);
    border-radius: calc(var(--pl-radius) * 2);
    background: var(--pl-color-bg-inset, #08080a);
    font-size: 0.95rem;
    color: var(--pl-color-fg);
  }
  .install-cmd .prompt {
    color: var(--pl-color-brand-lavender);
    margin-right: var(--pl-space-2);
  }
  .install-note {
    color: var(--pl-color-fg-muted);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
