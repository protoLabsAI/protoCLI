---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — proto" description="That page doesn't exist.">
  <section class="nf container">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lead">That page doesn't exist, or it moved.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/docs/">Read the docs</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: var(--pl-space-12) 0;
    text-align: center;
  }
  .code {
    font-family: var(--pl-font-mono);
    font-size: clamp(3rem, 12vw, 6rem);
    line-height: 1;
    margin: 0 0 var(--pl-space-2);
    background: var(--pl-gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf h1 {
    margin: 0 0 var(--pl-space-3);
  }
  .lead {
    color: var(--pl-color-fg-muted);
    margin: 0 0 var(--pl-space-6);
  }
  .cta {
    display: flex;
    gap: var(--pl-space-3);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
