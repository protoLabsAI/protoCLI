---
const year = 2026;
---

<footer class="footer">
  <div class="container footer-inner">
    <span>© {year} protoLabs.studio</span>
    <nav class="footer-links">
      <a href="/docs/">Docs</a>
      <a href="/changelog">Changelog</a>
      <a href="https://github.com/protoLabsAI/protoCLI">GitHub</a>
      <a href="https://protolabs.studio">protoLabs</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--pl-color-border);
    margin-top: var(--pl-space-12);
    padding: var(--pl-space-8) 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--pl-space-4);
    color: var(--pl-color-fg-muted);
    font-size: 0.88rem;
  }
  .footer-links {
    display: flex;
    gap: var(--pl-space-5);
  }
  .footer-links a {
    color: var(--pl-color-fg-muted);
  }
  .footer-links a:hover {
    color: var(--pl-color-fg);
    text-decoration: none;
  }
</style>
